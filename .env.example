# ==========================================
# Advance ERP — Environment Configuration Template
# Copy this file to .env and fill in real secrets.
# NEVER commit .env to source control!
# ==========================================

# Flask Security & Session Keys (Generate 32-byte hex tokens)
SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32

# Production MySQL Database Connection
DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/advance_erp
MYSQL_URI=mysql+pymysql://username:password@127.0.0.1:3306/advance_erp

# Target Research Database (agalabsdev_stage)
STAGE_DB_HOST=127.0.0.1
STAGE_DB_PORT=3306
STAGE_DB_USER=username
STAGE_DB_PASS=password
STAGE_DB_NAME=agalabsdev_stage

# SMTP Server Credentials (Sending Automated MIS Digests)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@domain.com

# Gmail IMAP Credentials (Market Intelligence Ingestion)
GMAIL_IMAP_SERVER=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_USER=your_email@domain.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_ACCOUNT_PASSWORD=your_account_password
GMAIL_SEARCH_CRITERIA=ALL

